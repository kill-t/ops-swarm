# 真实模型配置。复制为 .env 后填写；.env 已被 Git 忽略。
LLM_API_KEY=
LLM_MODEL=
# 可选 OpenAI 兼容接口，例如 https://api.example.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0
# 供应商默认、开启或关闭思考模式：provider_default / enabled / disabled
LLM_THINKING_MODE=provider_default
# 供应商支持的结构化输出方式：json_schema / json_mode / function_calling
LLM_STRUCTURED_OUTPUT_METHOD=json_schema

# Prometheus 只读调查数据源；默认值指向本机 Compose 端口。
OPSSWARM_INVESTIGATION_PROMETHEUS_BASE_URL=http://127.0.0.1:19090
OPSSWARM_INVESTIGATION_LOKI_BASE_URL=http://127.0.0.1:13100
OPSSWARM_INVESTIGATION_CHANGE_BASE_URL=http://127.0.0.1:18002
OPSSWARM_INVESTIGATION_REQUEST_TIMEOUT_SECONDS=3
# 默认只读本地变更模拟器；显式改为 simulator_and_github 才会补充 GitHub 证据。
OPSSWARM_INVESTIGATION_CHANGE_PROVIDER=simulator
# GitHub 仓库使用 owner/repo；私有仓库令牌只授予 Contents 与 Pull requests 读取权限。
OPSSWARM_GITHUB_REPOSITORY=
OPSSWARM_GITHUB_TOKEN=
OPSSWARM_GITHUB_REQUEST_TIMEOUT_SECONDS=5

# 调查 Worker 只领取与该模式一致的持久任务；默认冻结，现场模式必须显式开启。
OPSSWARM_WORKER_DATA_SOURCE_MODE=frozen
# 两个 Compose 工作池共用的轮询、租约、处理超时和退避边界。
OPSSWARM_WORKER_POLL_INTERVAL_SECONDS=1
OPSSWARM_WORKER_LEASE_DURATION_SECONDS=120
OPSSWARM_WORKER_PROCESSING_TIMEOUT_SECONDS=100
OPSSWARM_WORKER_BASE_RETRY_DELAY_SECONDS=5
OPSSWARM_WORKER_MAX_RETRY_DELAY_SECONDS=300

# OpenTelemetry trace 默认关闭；开启后只发送到本地 Compose Jaeger。
OPSSWARM_OTEL_ENABLED=false
OPSSWARM_OTEL_TRACES_ENDPOINT=http://127.0.0.1:14318/v1/traces
OPSSWARM_OTEL_SAMPLE_RATIO=1
OPSSWARM_OTEL_EXPORT_TIMEOUT_SECONDS=2

# 真实模型调查与评测共用的价格及评测费用护栏，单位均为美元。
# 请按所选模型的实际价格填写；Worker 会为每次调查保存价格快照，项目不会硬编码可能过期的价格。
EVALUATION_INPUT_COST_PER_MILLION_USD=
EVALUATION_OUTPUT_COST_PER_MILLION_USD=
EVALUATION_MAX_COST_USD=0.10
# 一次批量命令允许的累计估算费用上限
EVALUATION_MAX_BATCH_COST_USD=0.10

# 恢复验证 Worker 可选参数；默认值已适合本地 Compose。
OPSSWARM_VERIFIER_PROMETHEUS_BASE_URL=http://127.0.0.1:19090
OPSSWARM_VERIFIER_REQUEST_TIMEOUT_SECONDS=3
OPSSWARM_VERIFIER_MAX_SAMPLE_AGE_SECONDS=10
OPSSWARM_VERIFICATION_WORKER_POLL_INTERVAL_SECONDS=1
OPSSWARM_VERIFICATION_WORKER_LEASE_DURATION_SECONDS=15
OPSSWARM_VERIFICATION_WORKER_BASE_RETRY_DELAY_SECONDS=2
OPSSWARM_VERIFICATION_WORKER_MAX_RETRY_DELAY_SECONDS=60
