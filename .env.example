# 真实模型配置。复制为 .env 后填写；.env 已被 Git 忽略。
LLM_API_KEY=
LLM_MODEL=
# 可选 OpenAI 兼容接口，例如 https://api.example.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0
# 供应商默认、开启或关闭思考模式：provider_default / enabled / disabled
LLM_THINKING_MODE=provider_default
# 供应商支持的结构化输出方式：json_schema / json_mode / function_calling
LLM_STRUCTURED_OUTPUT_METHOD=json_schema

# 真实模型评测的价格与费用护栏，单位均为美元。
# 请按所选模型的实际价格填写，项目不会硬编码可能过期的价格。
EVALUATION_INPUT_COST_PER_MILLION_USD=
EVALUATION_OUTPUT_COST_PER_MILLION_USD=
EVALUATION_MAX_COST_USD=0.10
